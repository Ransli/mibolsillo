
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext", "DOM"],
    "module": "ES2020",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,

    // 👇 Necesario para usar @Injectable, @Component, etc.
    "experimentalDecorators": true,

    // Recomendado para Angular 17 + TS 5.x
    "useDefineForClassFields": false,
    "forceConsistentCasingInFileNames": true
  }
}
